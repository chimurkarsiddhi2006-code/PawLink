rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function responder() { return signedIn() && profile().role in ['vet', 'ngo', 'shelter', 'pharmacy', 'authority', 'admin']; }
    function sameCity(data) { return signedIn() && data.city == profile().city; }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'citizen'
        && request.resource.data.keys().hasOnly(['name', 'email', 'city', 'role', 'requestedRole', 'status', 'createdAt']);
      allow read: if signedIn() && (request.auth.uid == userId || responder());
      // Users can change basic contact details, but never self-approve or self-assign a partner role.
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll(['reference', 'issue', 'location', 'status', 'city', 'reporterId']);
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || (responder() && sameCity(resource.data)));
      allow update: if responder() && sameCity(resource.data);
      allow delete: if false;
    }
  }
}
